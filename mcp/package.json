    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nemesis-shield",
    "security",
    "waf",
