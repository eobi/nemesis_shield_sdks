  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "mcpName": "io.github.eobi/nemesis-shield",
  "engines": {
    "node": ">=18"
  }
