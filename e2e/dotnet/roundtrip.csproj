<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Mirrors tokenizetest.csproj: pull the SDK source in directly (self-contained NemesisShield.cs)
       so the round-trip uses the exact same tokenizer/shape code the SDK ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>roundtrip</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NemesisShield.cs" />
  </ItemGroup>
</Project>
