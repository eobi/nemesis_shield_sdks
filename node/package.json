  "homepage": "https://github.com/eobi/nemesis_shield_sdks/tree/main/node",
  "repository": { "type": "git", "url": "https://github.com/eobi/nemesis_shield_sdks.git", "directory": "node" },
  "engines": { "node": ">=18" }
